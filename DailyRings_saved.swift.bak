import SwiftUI

/// Apple Fitness–inspired activity rings card
struct DailyRings: View {
    @Environment(TimelineStore.self) private var store

    private let sleepGoalHours: Double = 4
    private let feedGoal: Int = 6
    private let diaperGoal: Int = 6

    var body: some View {
        VStack(spacing: 0) {
            // ── Rings — big & centered like Apple Fitness ──
            ZStack {
                ring(progress: sleepProgress, color: .moonSleep, lineWidth: 18, radius: 68)
                ring(progress: feedProgress, color: .moonFood, lineWidth: 18, radius: 48)
                ring(progress: diaperProgress, color: .moonChange, lineWidth: 18, radius: 28)
            }
            .frame(width: 172, height: 172)
            .padding(.top, 24)
            .padding(.bottom, 20)

            // ── Stat rows — colored accent like Move/Exercise/Stand ──
            VStack(spacing: 0) {
                statRow(
                    color: .moonSleep,
                    label: "Sleep",
                    value: formatSleep(store.totalSleepToday),
                    goal: "/\(Int(sleepGoalHours))h",
                    progress: sleepProgress
                )

                Divider()
                    .foregroundStyle(.moonStone.opacity(0.5))
                    .padding(.leading, 44)

                statRow(
                    color: .moonFood,
                    label: "Feeding",
                    value: "\(store.countToday([.bottle, .nursing, .pumping, .solids]))",
                    goal: "/\(feedGoal) feeds",
                    progress: feedProgress
                )

                Divider()
                    .foregroundStyle(.moonStone.opacity(0.5))
                    .padding(.leading, 44)

                statRow(
                    color: .moonChange,
                    label: "Diapers",
                    value: "\(store.countToday([.diaper]))",
                    goal: "/\(diaperGoal) changes",
                    progress: diaperProgress
                )
            }
        }
        .background {
            RoundedRectangle(cornerRadius: 24, style: .continuous)
                .fill(.moonWhite)
                .shadow(color: .moonBlack.opacity(0.06), radius: 16, y: 6)
        }
        .padding(.horizontal, 16)
    }

    // MARK: - Stat Row

    private func statRow(color: Color, label: String, value: String, goal: String, progress: Double) -> some View {
        HStack(spacing: 14) {
            // Ring icon — mini version
            ZStack {
                Circle()
                    .stroke(color.opacity(0.2), lineWidth: 4)
                Circle()
                    .trim(from: 0, to: min(progress, 1.0))
                    .stroke(color, style: StrokeStyle(lineWidth: 4, lineCap: .round))
                    .rotationEffect(.degrees(-90))
            }
            .frame(width: 24, height: 24)

            // Label
            Text(label)
                .font(.system(size: 16, weight: .semibold))
                .foregroundStyle(.moonObsidian)

            Spacer()

            // Value + goal
            HStack(alignment: .firstTextBaseline, spacing: 2) {
                Text(value)
                    .font(.kepler(24))
                    .foregroundStyle(.moonObsidian)
                Text(goal)
                    .font(.system(size: 14, weight: .medium))
                    .foregroundStyle(.moonClay)
            }
        }
        .padding(.horizontal, 20)
        .padding(.vertical, 14)
    }

    // MARK: - Ring

    private func ring(progress: Double, color: Color, lineWidth: CGFloat, radius: CGFloat) -> some View {
        ZStack {
            // Track
            Circle()
                .stroke(color.opacity(0.15), style: StrokeStyle(lineWidth: lineWidth, lineCap: .round))
                .frame(width: radius * 2, height: radius * 2)

            // Progress arc
            Circle()
                .trim(from: 0, to: min(progress, 1.0))
                .stroke(color, style: StrokeStyle(lineWidth: lineWidth, lineCap: .round))
                .rotationEffect(.degrees(-90))
                .frame(width: radius * 2, height: radius * 2)
                .shadow(color: color.opacity(0.4), radius: 6, y: 2)

            // Bright end cap
            if progress > 0.05 {
                Circle()
                    .fill(color)
                    .frame(width: lineWidth + 2, height: lineWidth + 2)
                    .shadow(color: .white, radius: 1)
                    .shadow(color: color.opacity(0.6), radius: 4)
                    .offset(y: -radius)
                    .rotationEffect(.degrees(360 * min(progress, 1.0) - 90))
                    .frame(width: radius * 2, height: radius * 2)
            }
        }
    }

    // MARK: - Helpers

    private var sleepProgress: Double {
        store.totalSleepToday / (sleepGoalHours * 3600)
    }

    private var feedProgress: Double {
        Double(store.countToday([.bottle, .nursing, .pumping, .solids])) / Double(feedGoal)
    }

    private var diaperProgress: Double {
        Double(store.countToday([.diaper])) / Double(diaperGoal)
    }

    private func formatSleep(_ interval: TimeInterval) -> String {
        let hours = Int(interval) / 3600
        let minutes = (Int(interval) % 3600) / 60
        if hours > 0 {
            return "\(hours)h \(minutes)m"
        } else {
            return "\(minutes)m"
        }
    }
}
